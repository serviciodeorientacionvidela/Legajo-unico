# --- Base de datos (Neon PostgreSQL) ---
# Usar la cadena "pooled" de Neon. sslmode=require es obligatorio.
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.sa-east-1.aws.neon.tech/legajo_unico?sslmode=require"

# --- Sesión ---
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
NEXTAUTH_SECRET="reemplazar-por-un-secreto-largo-y-aleatorio"

# --- Google Drive (Service Account) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL="lue-drive@proyecto-escuela.iam.gserviceaccount.com"
# Pegar la clave con los saltos de línea escapados como \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# ID de la carpeta institucional (idealmente en una Unidad Compartida) donde el sistema
# busca o crea "LEGAJO_UNICO_ESTUDIANTES_2026". Debe estar compartida con la Service Account como Editor.
GOOGLE_DRIVE_ROOT_FOLDER_ID="1AbCdEfGhIjKlMnOpQrStUvWxYz"

# --- Portal GEI (DGE Mendoza) ---
GEI_USER="usuario-establecimiento"
GEI_PASS="password-gei"
# URL de ingreso al portal (sobrescribible si cambia)
GEI_LOGIN_URL="https://gei.mendoza.edu.ar/"
# Reportes a descargar, formato nombre|url separados por ";"
GEI_REPORTES="matricula|https://gei.mendoza.edu.ar/reportes/matricula;asistencia|https://gei.mendoza.edu.ar/reportes/asistencia;notas|https://gei.mendoza.edu.ar/reportes/calificaciones"
# Usuario DIRECTIVO_SOE al que se atribuye la importación automática en la auditoría
GEI_SYNC_USER_EMAIL="direccion@escuela.edu.ar"
# Selectores CSS opcionales (calibrar con: npm run gei:scrape -- --headed --solo-descargar)
# GEI_SELECTOR_USUARIO='input[name="usuario"]'
# GEI_SELECTOR_PASSWORD='input[type="password"]'
# GEI_SELECTOR_INGRESAR='button[type="submit"]'
# GEI_SELECTOR_EXPORTAR='button:has-text("Exportar")'

# --- Seed de prueba (npm run db:seed) ---
# Contraseña de los usuarios de prueba (mínimo 12 caracteres). Nunca usar en producción.
SEED_PASSWORD="cambiar-esta-clave-de-prueba"

# --- Interfaz ---
# "true" = el dashboard funciona con datos semilla en memoria (sin base de datos)
NEXT_PUBLIC_DEMO_MODE="true"
