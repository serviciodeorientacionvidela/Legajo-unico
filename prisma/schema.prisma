// Legajo Único del Estudiante (LUE)
// Datos personales de menores: Ley 25.326 (Protección de Datos Personales) y Ley 26.061 (Protección Integral NNyA).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  DIRECTIVO_SOE
  PRECEPTOR
  DOCENTE
}

enum EstadoMatricula {
  REGULAR
  PASE
  EGRESADO
}

enum TipoIncidente {
  LEVE
  MODERADA
  GRAVE
  ACUERDO_PEDAGOGICO
}

enum AccionAuditoria {
  VER_LEGAJO
  VER_CUD_SOE
  CARGAR_ACTA
  IMPORTAR_GEI
  CARGAR_INTERVENCION
  EDITAR_CONFIDENCIAL
  GENERAR_INFORME
  GESTIONAR_USUARIO
}

model Usuario {
  id              String    @id @default(cuid())
  email           String    @unique
  nombre          String
  passwordHash    String
  rol             Rol
  activo          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  dni             String?   @unique
  /// Cuenta master: puede crear y administrar usuarios (independiente del rol).
  esAdministrador Boolean   @default(false)
  /// Foto de perfil como data URL (JPEG reducido a 256 px en el navegador).
  fotoPerfil      String?   @db.Text
  fotoActualizada DateTime?

  incidentesCargados IncidenteConvivencia[]
  intervencionesSoe  IntervencionSoe[]
  auditLogs          AuditLog[]
}

model Estudiante {
  id                   String    @id @default(cuid())
  dni                  String    @unique
  cuil                 String?
  apellidos            String
  nombres              String
  fechaNacimiento      DateTime?
  genero               String?
  anio                 Int // 1 a 5 (validado en la capa de aplicación)
  division             String
  turno                String
  promedioGeneral      Float     @default(0)
  porcentajeAsistencia Float     @default(100)
  puntosConvivencia    Int       @default(20)
  tieneCud             Boolean   @default(false)
  vencimientoCud       DateTime?
  requierePpi          Boolean   @default(false)

  // --- Contacto familiar (GEI): solo PRECEPTOR y DIRECTIVO_SOE. Multilínea: un renglón por familiar ---
  direccion           String?
  localidad           String?
  familiares          String?
  telefonosFamiliares String?
  emailsFamiliares    String?
  emailContacto       String?

  // --- Datos sensibles: solo nivel 3 (DIRECTIVO_SOE) ---
  diagnosticoReservado        String?
  cudUrl                      String?
  observacionesConfidenciales String?

  // --- Google Drive ---
  driveFolderId              String?
  driveDocumentacionFolderId String?
  driveConvivenciaFolderId   String?
  driveConfidencialFolderId  String?

  estadoMatricula EstadoMatricula @default(REGULAR)
  updatedAt       DateTime        @updatedAt

  calificaciones CalificacionMateria[]
  incidentes     IncidenteConvivencia[]
  intervenciones IntervencionSoe[]
  trayectoria    TrayectoriaEscolar[]
  alertas        AlertaTemprana[]
  faltasIce      FaltaIce[]
  asistencias    AsistenciaMensual[]

  @@index([anio, division])
  @@index([apellidos])
}

model CalificacionMateria {
  id                  String     @id @default(cuid())
  estudianteId        String
  estudiante          Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  materia             String
  cicloLectivo        Int
  primerCuatrimestre  Float?
  segundoCuatrimestre Float?
  notaFinal           Float?
  previa              Boolean    @default(false)

  @@unique([estudianteId, materia, cicloLectivo])
}

// --- Ficha del alumno en el GEI: se reemplaza completa en cada sincronización. PRECEPTOR y DIRECTIVO_SOE ---

/**
 * Un renglón por ciclo y escuela (incluye primaria y otras escuelas).
 */
model TrayectoriaEscolar {
  id            String     @id @default(cuid())
  estudianteId  String
  estudiante    Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  cicloLectivo  Int
  condicion     String?
  escuela       String
  division      String?
  fechaIngreso  DateTime?
  motivoIngreso String?
  fechaEgreso   DateTime?
  /// PROMOCIÓN, PERMANENCIA (repitencia), pase, etc.
  motivoEgreso  String?
  activo        Boolean    @default(false)
  inasistencias Float?

  @@index([estudianteId, cicloLectivo])
}

/**
 * Sistema de Alertas Tempranas del GEI.
 */
model AlertaTemprana {
  id               String     @id @default(cuid())
  estudianteId     String
  estudiante       Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  fecha            DateTime?
  escuela          String?
  causas           String
  planIntervencion String?
  observaciones    String?

  @@index([estudianteId, fecha])
}

/**
 * Faltas del régimen de convivencia (Puntos ICE) cargadas en el GEI. El GEI es la fuente oficial:
 * Estudiante.puntosConvivencia toma el total del GEI en cada sincronización.
 */
model FaltaIce {
  id           String     @id @default(cuid())
  estudianteId String
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  cicloLectivo Int
  fecha        DateTime?
  puntos       Int
  /// Leve, Moderada, Grave
  tipo         String
  dadaDeBaja   Boolean    @default(false)
  fechaBaja    DateTime?

  @@index([estudianteId, cicloLectivo])
}

/**
 * Resumen mensual de asistencia del GEI PAD (inasistencias en días, admite medias faltas).
 */
model AsistenciaMensual {
  id                 String     @id @default(cuid())
  estudianteId       String
  estudiante         Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  cicloLectivo       Int
  /// Primer Período, Segundo Período, Intensificación
  periodo            String
  /// Orden del mes dentro del ciclo (para graficar en secuencia)
  orden              Int
  mes                String
  justificadas       Float?
  injustificadas     Float?
  totalInasistencias Float?
  diasAsistidos      Float?
  porcentaje         Float?
  cerrado            Boolean    @default(false)

  @@index([estudianteId, cicloLectivo])
}

model IncidenteConvivencia {
  id                String        @id @default(cuid())
  estudianteId      String
  estudiante        Estudiante    @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  autorId           String
  autor             Usuario       @relation(fields: [autorId], references: [id])
  fecha             DateTime
  tipo              TipoIncidente
  puntosDescontados Int
  motivo            String
  descargoAlumno    String?
  medidaAdoptada    String?
  notificadoFamilia Boolean       @default(false)
  actaDriveUrl      String?
  // Circuito de aprobación (matriz de permisos): el Preceptor carga, el Directivo aprueba/da de baja.
  // Los puntos solo se descuentan del Estudiante cuando aprobado = true.
  aprobado          Boolean       @default(false)
  aprobadoPorId     String?
  anulado           Boolean       @default(false)

  @@index([estudianteId, fecha])
}

model IntervencionSoe {
  id                  String     @id @default(cuid())
  estudianteId        String
  estudiante          Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  profesionalId       String
  profesional         Usuario    @relation(fields: [profesionalId], references: [id])
  fecha               DateTime
  /// ENTREVISTA_ESTUDIANTE, ENTREVISTA_FAMILIA, REUNION_DOCENTES, OBSERVACION_AULICA, DERIVACION_EXTERNA, OTRA
  tipo                String     @default("ENTREVISTA_ESTUDIANTE")
  participantes       String?
  motivo              String
  informeConfidencial String     @db.Text
  acuerdosDocentes    String     @db.Text // visible para docentes: sin datos clínicos
  archivoDriveUrl     String?
  /// Fecha acordada para el próximo seguimiento (agenda del SOE).
  proximoSeguimiento  DateTime?

  @@index([estudianteId, fecha])
  @@index([proximoSeguimiento])
}

model AuditLog {
  id            String          @id @default(cuid())
  usuarioId     String
  usuario       Usuario         @relation(fields: [usuarioId], references: [id])
  estudianteDni String?
  accion        AccionAuditoria
  ipAddress     String?
  createdAt     DateTime        @default(now())

  @@index([estudianteDni, createdAt])
  @@index([usuarioId, createdAt])
}
