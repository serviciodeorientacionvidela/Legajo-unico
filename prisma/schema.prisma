// Legajo Único del Estudiante (LUE)
// Datos personales de menores: Ley 25.326 (Protección de Datos Personales) y Ley 26.061 (Protección Integral NNyA).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  DIRECTIVO_SOE
  PRECEPTOR
  DOCENTE
}

enum EstadoMatricula {
  REGULAR
  PASE
  EGRESADO
  ABANDONO
}

enum TipoIncidente {
  LEVE
  MODERADA
  GRAVE
  ACUERDO_PEDAGOGICO
}

enum AccionAuditoria {
  VER_LEGAJO
  VER_CUD_SOE
  CARGAR_ACTA
  IMPORTAR_GEI
  CARGAR_INTERVENCION
  EDITAR_CONFIDENCIAL
  GENERAR_INFORME
  GESTIONAR_USUARIO
  CARGAR_ACTUACION
  CARGAR_DERIVACION
  REGISTRAR_SEGUIMIENTO
  GESTIONAR_SITUACION
  VER_FICHA_ANEXA
  EDITAR_FICHA_ANEXA
  VER_REPORTE_RESTRINGIDO
  GESTIONAR_NORMATIVA
}

// --- Seguimiento de trayectorias (maquetas: legajo, nueva actuación, derivación, apertura y reportes) ---

/// Los 9 tipos de la maqueta "Nueva actuación".
enum TipoActuacion {
  INASISTENCIAS
  CONVIVENCIA_ICE
  FAMILIA
  SALUD
  PROTOCOLO
  ESCOLARIDAD_PROTEGIDA
  DEPORTISTA_FEDERADO
  INCLUSION_PPI
  GENERO
  ESCUELA_DOMICILIARIA
  OTRA
}

/// Por qué se abrió el legajo (maqueta "Cuándo se abre el legajo").
enum MotivoApertura {
  INASISTENCIAS
  ICE_CERO
  FALTA_GRAVE
  PROTOCOLO
  DERIVACION_SOE
  CONDICIONALIDAD
  ESCOLARIDAD_PROTEGIDA
  PPI
  DEPORTISTA_FEDERADO
  OTRO
}

enum DestinoDerivacion {
  INTERNA_PSICOPEDAGOGICA
  INTERNA_SOCIAL
  EXTERNA_ORGANISMO
}

enum EstadoDerivacion {
  /// En la bandeja del SOE, sin la parte B.
  PENDIENTE
  EN_CURSO
  CERRADA
}

enum EstadoSeguimiento {
  PROGRAMADO
  REALIZADO
  CANCELADO
}

enum TipoSituacion {
  CUD_EVALUACION
  INGRESANTE
  SALIDA
  NO_ASISTE
  CONDICIONAL_ICE
  ESCOLARIDAD_PROTEGIDA
  DEPORTISTA_FEDERADO
  CONDICIONAL_INASISTENCIAS
  EXTENSION_INASISTENCIAS
  EMBARAZO_PATERNIDAD_LACTANCIA
  ENFERMEDAD_APRENDIZAJE
  JUDICIALIZADO
  ESCUELA_DOMICILIARIA
  CAMBIO_GENERO
  OTRA
}

/// "Por vencer" y "vencida" no se guardan: se calculan con fechaVencimiento.
enum EstadoSituacion {
  /// Pedida o a la espera del aval (por ejemplo, extensión de inasistencias sin aval de Supervisión).
  PENDIENTE
  VIGENTE
  CUMPLIDA
  DENEGADA
  DADA_DE_BAJA
}

/// GENERAL: preceptoría y equipo directivo/SOE. RESTRINGIDO: SOE y equipo directivo. SOLO_DIRECCION: equipo directivo.
enum NivelAcceso {
  GENERAL
  RESTRINGIDO
  SOLO_DIRECCION
}

enum TipoFichaAnexa {
  SALUD
  PSICOSOCIAL
}

enum TipoNotificacion {
  SEGUIMIENTO_PROXIMO
  SEGUIMIENTO_HOY
  SEGUIMIENTO_VENCIDO
  DERIVACION_RECIBIDA
  ALERTA_INASISTENCIAS
  LEGAJO_ABIERTO
  SITUACION_POR_VENCER
  TICKET_ACTUALIZADO
  MENSAJE_NUEVO
  GEI_SINCRONIZADO
}

model Usuario {
  perfilSeguimiento PerfilSeguimiento?
  id              String    @id @default(cuid())
  email           String    @unique
  nombre          String
  passwordHash    String
  /// Contraseña generada por la cuenta técnica: obliga a cambiarla en el próximo ingreso.
  debeCambiarPassword Boolean @default(false)
  /// La contraseña temporal, cifrada (AES-GCM), para que la cuenta técnica pueda reenviarla.
  /// Se borra cuando la persona elige la suya: las contraseñas propias no se guardan legibles.
  passwordTemporalCifrada String?
  rol             Rol
  /// Cargo institucional (Director/a, Regente, Orientador/a social, Preceptor/a…). Lista en src/lib/types.ts.
  cargo           String?
  activo          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  dni             String?   @unique
  /// Cuenta master: puede crear y administrar usuarios (independiente del rol).
  esAdministrador Boolean   @default(false)
  /// Foto de perfil como data URL (JPEG reducido a 256 px en el navegador).
  fotoPerfil      String?   @db.Text
  fotoActualizada DateTime?

  incidentesCargados IncidenteConvivencia[]
  intervencionesSoe  IntervencionSoe[]
  auditLogs          AuditLog[]

  actuaciones            Actuacion[]
  derivacionesEnviadas   Derivacion[]        @relation("DerivacionDerivadoPor")
  derivacionesAtendidas  Derivacion[]        @relation("DerivacionProfesionalSoe")
  derivacionesRecibidas  Derivacion[]        @relation("DerivacionDestinatario")
  conversacionesCreadas  Conversacion[]
  participaciones        ParticipanteConversacion[]
  mensajes               Mensaje[]
  documentosSubidos      DocumentoNormativa[]
  adjuntosSubidos        AdjuntoActuacion[]
  seguimientosACargo     SeguimientoCaso[]
  situacionesRegistradas SituacionEspecial[]
  fichasCargadas         FichaAnexa[]
  notificaciones         Notificacion[]
}

model Estudiante {
  aperturaTrayectoria Json?
  id                   String    @id @default(cuid())
  dni                  String    @unique
  cuil                 String?
  apellidos            String
  nombres              String
  fechaNacimiento      DateTime?
  genero               String?
  anio                 Int // 1 a 5 (validado en la capa de aplicación)
  division             String
  turno                String
  promedioGeneral      Float     @default(0)
  porcentajeAsistencia Float     @default(100)
  puntosConvivencia    Int       @default(20)
  tieneCud             Boolean   @default(false)
  vencimientoCud       DateTime?
  requierePpi          Boolean   @default(false)

  // --- Contacto familiar (GEI): solo PRECEPTOR y DIRECTIVO_SOE. Multilínea: un renglón por familiar ---
  direccion           String?
  localidad           String?
  familiares          String?
  telefonosFamiliares String?
  emailsFamiliares    String?
  emailContacto       String?

  // --- Datos sensibles: solo nivel 3 (DIRECTIVO_SOE) ---
  diagnosticoReservado        String?
  cudUrl                      String?
  observacionesConfidenciales String?

  // --- Google Drive ---
  driveFolderId              String?
  driveDocumentacionFolderId String?
  driveConvivenciaFolderId   String?
  driveConfidencialFolderId  String?
  /// Huella de la última ficha importada del GEI: si no cambió, el barrido no la reescribe.
  fichaGeiHash               String?

  estadoMatricula EstadoMatricula @default(REGULAR)
  updatedAt       DateTime        @updatedAt

  // --- Apertura del legajo de seguimiento: null mientras no se haya abierto ---
  legajoAbiertoEl       DateTime?
  motivoApertura        MotivoApertura?
  /// Texto que acompaña al motivo, p. ej. "Intervención del SOE".
  detalleApertura       String?
  // Foto del rendimiento el día de la apertura (para "al abrir: 9 · límite 20").
  aperturaPromedio      Float?
  aperturaPendientes    Int?
  aperturaInasistencias Float?
  aperturaIce           Int?

  calificaciones CalificacionMateria[]
  incidentes     IncidenteConvivencia[]
  intervenciones IntervencionSoe[]
  trayectoria    TrayectoriaEscolar[]
  alertas        AlertaTemprana[]
  faltasIce      FaltaIce[]
  asistencias    AsistenciaMensual[]
  actuaciones    Actuacion[]
  derivaciones   Derivacion[]
  seguimientos   SeguimientoCaso[]
  situaciones    SituacionEspecial[]
  fichasAnexas   FichaAnexa[]
  notificaciones Notificacion[]

  @@index([anio, division])
  @@index([apellidos])
}

model CalificacionMateria {
  id                  String     @id @default(cuid())
  estudianteId        String
  estudiante          Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  materia             String
  cicloLectivo        Int
  primerCuatrimestre  Float?
  segundoCuatrimestre Float?
  notaFinal           Float?
  previa              Boolean    @default(false)

  @@unique([estudianteId, materia, cicloLectivo])
}

// --- Ficha del alumno en el GEI: se reemplaza completa en cada sincronización. PRECEPTOR y DIRECTIVO_SOE ---

/**
 * Un renglón por ciclo y escuela (incluye primaria y otras escuelas).
 */
model TrayectoriaEscolar {
  id            String     @id @default(cuid())
  estudianteId  String
  estudiante    Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  cicloLectivo  Int
  condicion     String?
  escuela       String
  division      String?
  fechaIngreso  DateTime?
  motivoIngreso String?
  fechaEgreso   DateTime?
  /// PROMOCIÓN, PERMANENCIA (repitencia), pase, etc.
  motivoEgreso  String?
  activo        Boolean    @default(false)
  inasistencias Float?

  @@index([estudianteId, cicloLectivo])
}

/**
 * Sistema de Alertas Tempranas del GEI.
 */
model AlertaTemprana {
  id               String     @id @default(cuid())
  estudianteId     String
  estudiante       Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  fecha            DateTime?
  escuela          String?
  causas           String
  planIntervencion String?
  observaciones    String?

  @@index([estudianteId, fecha])
}

/**
 * Faltas del régimen de convivencia (Puntos ICE) cargadas en el GEI. El GEI es la fuente oficial:
 * Estudiante.puntosConvivencia toma el total del GEI en cada sincronización.
 */
model FaltaIce {
  id           String     @id @default(cuid())
  estudianteId String
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  cicloLectivo Int
  fecha        DateTime?
  puntos       Int
  /// Leve, Moderada, Grave
  tipo         String
  dadaDeBaja   Boolean    @default(false)
  fechaBaja    DateTime?

  @@index([estudianteId, cicloLectivo])
}

/**
 * Resumen mensual de asistencia del GEI PAD (inasistencias en días, admite medias faltas).
 */
model AsistenciaMensual {
  id                 String     @id @default(cuid())
  estudianteId       String
  estudiante         Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  cicloLectivo       Int
  /// Primer Período, Segundo Período, Intensificación
  periodo            String
  /// Orden del mes dentro del ciclo (para graficar en secuencia)
  orden              Int
  mes                String
  justificadas       Float?
  injustificadas     Float?
  totalInasistencias Float?
  diasAsistidos      Float?
  porcentaje         Float?
  cerrado            Boolean    @default(false)

  @@index([estudianteId, cicloLectivo])
}

model IncidenteConvivencia {
  id                String        @id @default(cuid())
  estudianteId      String
  estudiante        Estudiante    @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  autorId           String
  autor             Usuario       @relation(fields: [autorId], references: [id])
  fecha             DateTime
  tipo              TipoIncidente
  puntosDescontados Int
  motivo            String
  descargoAlumno    String?
  medidaAdoptada    String?
  notificadoFamilia Boolean       @default(false)
  actaDriveUrl      String?
  // Circuito de aprobación (matriz de permisos): el Preceptor carga, el Directivo aprueba/da de baja.
  // Los puntos solo se descuentan del Estudiante cuando aprobado = true.
  aprobado          Boolean       @default(false)
  aprobadoPorId     String?
  anulado           Boolean       @default(false)

  /// Actuación que originó la quita de puntos (efecto "Quita de puntos ICE").
  actuacion Actuacion?

  @@index([estudianteId, fecha])
}

model IntervencionSoe {
  id                  String     @id @default(cuid())
  estudianteId        String
  estudiante          Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  profesionalId       String
  profesional         Usuario    @relation(fields: [profesionalId], references: [id])
  fecha               DateTime
  /// ENTREVISTA_ESTUDIANTE, ENTREVISTA_FAMILIA, REUNION_DOCENTES, OBSERVACION_AULICA, DERIVACION_EXTERNA, OTRA
  tipo                String     @default("ENTREVISTA_ESTUDIANTE")
  participantes       String?
  motivo              String
  informeConfidencial String     @db.Text
  acuerdosDocentes    String     @db.Text // visible para docentes: sin datos clínicos
  archivoDriveUrl     String?
  /// Fecha acordada para el próximo seguimiento (agenda del SOE).
  proximoSeguimiento  DateTime?
  /// Actuación de la línea de tiempo del legajo a la que pertenece esta intervención (agrupa el caso).
  actuacionId         String?
  actuacion           Actuacion? @relation(fields: [actuacionId], references: [id], onDelete: SetNull)

  @@index([estudianteId, fecha])
  @@index([proximoSeguimiento])
  @@index([actuacionId])
}

model AuditLog {
  id            String          @id @default(cuid())
  usuarioId     String
  usuario       Usuario         @relation(fields: [usuarioId], references: [id])
  estudianteDni String?
  accion        AccionAuditoria
  ipAddress     String?
  createdAt     DateTime        @default(now())

  @@index([estudianteDni, createdAt])
  @@index([usuarioId, createdAt])
}

/**
 * Cada hecho de la línea de tiempo del legajo (maqueta "Nueva actuación").
 * El registro digital es un índice: el acta original sigue en el libro de actas.
 */
model Actuacion {
  anuladaEl DateTime?
  anuladaPorId String?
  motivoAnulacion String?
  id           String        @id @default(cuid())
  estudianteId String
  estudiante   Estudiante    @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  autorId      String
  autor        Usuario       @relation(fields: [autorId], references: [id])
  fecha        DateTime
  /// Para agrupar la línea de tiempo por ciclo lectivo.
  cicloLectivo Int
  tipo         TipoActuacion
  /// Una línea.
  motivo       String
  /// Hasta 3 líneas.
  resumen      String        @db.Text
  /// Causa específica según el tipo (p. ej. "+15 inasistencias", "Bullying"). Lista en src/lib/types.ts.
  causa        String?

  // --- Acta (si corresponde) ---
  /// Acta compromiso, citación con familia, acta de descargo, etc. (lista en src/lib/types.ts).
  tipoActa  String?
  actaLibro String?
  actaFolio String?
  actaNumero String?

  // --- Efectos ---
  confidencial Boolean               @default(false)
  /// Puntos ICE que se pidió quitar; la quita sigue el circuito de IncidenteConvivencia (preceptor carga, directivo aprueba).
  puntosIce    Int?
  incidenteId  String?               @unique
  incidente    IncidenteConvivencia? @relation(fields: [incidenteId], references: [id], onDelete: SetNull)

  /// Derivación al SOE a la que pertenece este paso, si la hay.
  derivacionId String?
  derivacion   Derivacion? @relation(fields: [derivacionId], references: [id], onDelete: SetNull)

  /// Situaciones que esta actuación marcó (p. ej. "Condicional por inasistencias").
  situaciones SituacionEspecial[]

  /// Intervenciones del SOE vinculadas a esta actuación.
  intervencionesSoe IntervencionSoe[]

  /// Actas en papel escaneadas (foto o PDF). No se borran: dejan constancia del original.
  adjuntos AdjuntoActuacion[]

  createdAt DateTime @default(now())

  @@index([estudianteId, fecha])
  @@index([estudianteId, cicloLectivo])
}

// Permisos explícitos del circuito LUE. No se infiere dirección de ser administrador.
model PerfilSeguimiento {
  usuarioId String @id
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  funcion String // DIRECCION, SOE o PRECEPTORIA
  cursos Json // [{anio: 3, division: "1", turno: "Mañana"}]
}

/**
 * Derivación al SOE. Parte A: quien deriva. Parte B: el SOE. Parte C: SeguimientoCaso.
 */
model Derivacion {
  id           String     @id @default(cuid())
  /// Número de ticket visible (#123) para quien deriva y quien recibe.
  numero       Int        @unique @default(autoincrement())
  estudianteId String
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  // --- A · La completa quien deriva ---
  fecha         DateTime
  derivadoPorId String
  derivadoPor   Usuario  @relation("DerivacionDerivadoPor", fields: [derivadoPorId], references: [id])
  motivo        String   @db.Text
  /// Usuario al que se deriva. Null: a todo el equipo SOE / dirección.
  destinatarioId String?
  destinatario   Usuario? @relation("DerivacionDestinatario", fields: [destinatarioId], references: [id])

  // --- B · La completa el SOE ---
  profesionalSoeId String?
  profesionalSoe   Usuario?           @relation("DerivacionProfesionalSoe", fields: [profesionalSoeId], references: [id])
  recibidaEl       DateTime?
  accionesSoe      String?            @db.Text
  /// Respuesta a quien deriva y a la familia (si corresponde).
  respuesta        String?            @db.Text
  destino          DestinoDerivacion?
  /// Solo para destino EXTERNA_ORGANISMO.
  organismoExterno String?

  estado    EstadoDerivacion @default(PENDIENTE)
  cerradaEl DateTime?

  seguimientos   SeguimientoCaso[]
  actuaciones    Actuacion[]
  situaciones    SituacionEspecial[]
  notificaciones Notificacion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado, fecha])
  @@index([estudianteId, fecha])
  @@index([destinatarioId, estado])
}

/**
 * Seguimiento programado o realizado (parte C de la derivación y "Seguimientos pendientes" del legajo).
 * Avisos: 2 días antes y el día de la fecha; si no se registra, se repite y llega al equipo directivo.
 */
model SeguimientoCaso {
  id            String             @id @default(cuid())
  estudianteId  String
  estudiante    Estudiante         @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  derivacionId  String?
  derivacion    Derivacion?        @relation(fields: [derivacionId], references: [id], onDelete: Cascade)
  situacionId   String?
  situacion     SituacionEspecial? @relation(fields: [situacionId], references: [id], onDelete: SetNull)
  responsableId String?
  responsable   Usuario?           @relation(fields: [responsableId], references: [id])

  fechaProgramada DateTime
  descripcion     String
  estado          EstadoSeguimiento @default(PROGRAMADO)
  realizadoEl     DateTime?
  /// Qué pasó (p. ej. "Se controla la asistencia de la semana. Mejora parcial.").
  resultado       String?           @db.Text

  avisoLue    Boolean @default(true)
  /// Correo institucional con el recordatorio, sin datos sensibles.
  avisoCorreo Boolean @default(false)

  notificaciones Notificacion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado, fechaProgramada])
  @@index([estudianteId, fechaProgramada])
  @@index([responsableId, estado])
}

/**
 * Situaciones especiales con forma, aval y vencimiento. Alimentan las etiquetas de "Situación actual",
 * las reglas de apertura del legajo y casi todos los reportes.
 */
model SituacionEspecial {
  id               String          @id @default(cuid())
  estudianteId     String
  estudiante       Estudiante      @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  tipo             TipoSituacion
  /// Escolaridad protegida: INASISTENCIAS, SALUD, DEPORTISTA_FEDERADO... (lista en src/lib/types.ts).
  forma            String?
  /// Quién avala: Dirección o Supervisión. null = sin aval todavía.
  aval             String?
  estado           EstadoSituacion @default(VIGENTE)
  nivelAcceso      NivelAcceso     @default(GENERAL)
  fechaInicio      DateTime
  fechaVencimiento DateTime?
  fechaFin         DateTime?
  /// Datos propios de cada tipo (federación, fecha probable, organismo, resolución...). Ver src/lib/types.ts.
  detalle          Json?
  observaciones    String?         @db.Text

  actuacionId     String?
  actuacion       Actuacion?  @relation(fields: [actuacionId], references: [id], onDelete: SetNull)
  derivacionId    String?
  derivacion      Derivacion? @relation(fields: [derivacionId], references: [id], onDelete: SetNull)
  registradaPorId String
  registradaPor   Usuario     @relation(fields: [registradaPorId], references: [id])

  seguimientos SeguimientoCaso[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tipo, estado])
  @@index([estudianteId, tipo])
  @@index([fechaVencimiento])
}

/**
 * Fichas de salud y psicosocial que se anexan al abrir el legajo.
 * Acceso: SOE y equipo directivo (a validar con el SOE). Cada consulta queda en la auditoría.
 */
model FichaAnexa {
  id           String         @id @default(cuid())
  estudianteId String
  estudiante   Estudiante     @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  tipo         TipoFichaAnexa
  /// Campos de la ficha; el formulario todavía no está definido.
  datos        Json
  cargadaPorId String
  cargadaPor   Usuario        @relation(fields: [cargadaPorId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([estudianteId, tipo])
}

/**
 * Avisos dentro del LUE (y, más adelante, por correo).
 */
model Notificacion {
  id              String           @id @default(cuid())
  usuarioId       String
  usuario         Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo            TipoNotificacion
  titulo          String
  mensaje         String
  enlace          String?
  estudianteId    String?
  estudiante      Estudiante?      @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  seguimientoId   String?
  seguimiento     SeguimientoCaso? @relation(fields: [seguimientoId], references: [id], onDelete: Cascade)
  derivacionId    String?
  derivacion      Derivacion?      @relation(fields: [derivacionId], references: [id], onDelete: Cascade)
  /// Evita que la tarea diaria repita el mismo aviso (p. ej. "seguimiento:<id>:hoy:<usuario>").
  claveDedup      String?          @unique
  leida           Boolean          @default(false)
  leidaEl         DateTime?
  correoEnviadoEl DateTime?
  createdAt       DateTime         @default(now())

  @@index([usuarioId, leida, createdAt])
}

// --- Mensajería interna ---

/// Conversación directa (dos personas, sin nombre) o grupo (con nombre).
model Conversacion {
  id            String                     @id @default(cuid())
  nombre        String?
  esGrupo       Boolean                    @default(false)
  creadaPorId   String
  creadaPor     Usuario                    @relation(fields: [creadaPorId], references: [id])
  participantes ParticipanteConversacion[]
  mensajes      Mensaje[]
  createdAt     DateTime                   @default(now())
  /// Fecha del último mensaje, para ordenar la bandeja.
  ultimoMensajeEl DateTime                 @default(now())
}

model ParticipanteConversacion {
  conversacionId  String
  conversacion    Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  usuarioId       String
  usuario         Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ultimaLecturaEl DateTime?
  unidoEl         DateTime     @default(now())

  @@id([conversacionId, usuarioId])
  @@index([usuarioId])
}

model Mensaje {
  id             String       @id @default(cuid())
  conversacionId String
  conversacion   Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  autorId        String
  autor          Usuario      @relation(fields: [autorId], references: [id])
  texto          String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([conversacionId, createdAt])
}

/// Documentos de la sección Normativa subidos por dirección / SOE (además de los fijos de public/normativa).
model DocumentoNormativa {
  id            String   @id @default(cuid())
  titulo        String
  descripcion   String?
  nombreArchivo String
  tipoMime      String
  tamanio       Int
  contenido     Bytes
  subidoPorId   String
  subidoPor     Usuario  @relation(fields: [subidoPorId], references: [id])
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

/// Foto o PDF de un acta en papel, adjunta a una actuación del legajo.
model AdjuntoActuacion {
  id            String    @id @default(cuid())
  actuacionId   String
  actuacion     Actuacion @relation(fields: [actuacionId], references: [id], onDelete: Cascade)
  nombreArchivo String
  tipoMime      String
  tamanio       Int
  contenido     Bytes
  subidoPorId   String
  subidoPor     Usuario   @relation(fields: [subidoPorId], references: [id])
  createdAt     DateTime  @default(now())

  @@index([actuacionId])
}
